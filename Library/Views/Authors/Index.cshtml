@model AuthorsIndexViewModel

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="fw-bold text-[2rem]">Authors</h1>
    @await Html.PartialAsync("_PageSizeSelector", Model.AuthorsListViewModel.Pagination)
</div>

<div id="paged-content">
    @(await Html.RenderPaginatedListAsync(Model.AuthorsListViewModel, @<text>
        @await Html.PartialAsync("_AuthorInfoCard", item)
    </text>))
</div>

@section Scripts {
    <script src="~/js/soft-pagination.js"></script>
}