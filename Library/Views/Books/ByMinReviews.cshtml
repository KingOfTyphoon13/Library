@model BooksByMinReviewsViewModel
@{
    ViewData["Title"] = "Books by Minimum Reviews";
}

<h1 class="fw-bold mb-4 text-center">Books by Minimum Reviews</h1>

<form method="get" asp-action="ByMinReviews" class="row g-2 justify-content-center mb-4">
    <div class="col-auto">
        <input type="number" name="minReviewCount" class="form-control"
               placeholder="Min review count" min="0"
               value="@Model.MinReviewCount" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filter</button>
    </div>
    @if (Model.MinReviewCount.HasValue)
    {
        <div class="col-auto">
            <a asp-action="ByMinReviews" class="btn btn-outline-secondary">Clear</a>
        </div>
    }
</form>

<partial name="_PageSizeSelector" model="Model.Paginated.Pagination" />
@if (!Model.Paginated.Items.Any())
{
    <p class="text-muted text-center">No books found.</p>
}
else
{
   

    <div id="@Model.Paginated.Pagination.ContainerId">
        @(await Html.RenderPaginatedListAsync(Model.Paginated, @<text>
            <div class="book-context-target" data-book-id="@item.Id">
                @await Html.PartialAsync("_BookInfoCard", item)
            </div>
        </text>))
    </div>
}
