@model ReviewIndexViewModel

<h2>Recent Reviews</h2>

<div class="review-grid">
    @foreach (var review in Model.RecentReviews)
    {
        <div class="review-card">
            @await Html.PartialAsync("_BookInfoCard", review.BookSummary)
            @await Html.PartialAsync("_ScoreBar", review.Score)
        </div>
    }
</div>

<a asp-action="Create" class="btn btn-primary mt-4">Add Review</a>