@model ReviewsIndexViewModel

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="fw-bold text-[2rem]">Recent Reviews</h1>
    @await Html.PartialAsync("_PageSizeSelector", Model.RecentReviews.Pagination)
</div>

<div id="paged-content">
    @(await Html.RenderPaginatedListAsync(Model.RecentReviews, @<text>
        @await Html.PartialAsync("_BookInfoCard", item.BookSummary)
        @await Html.PartialAsync("_ScoreBar", item.Score)
    </text>))
</div>

<a asp-action="Create" class="btn btn-primary mt-4">Add Review</a>

@section Scripts {
    <script src="~/js/soft-pagination.js"></script>
}