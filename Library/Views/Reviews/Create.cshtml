@model ReviewCreateViewModel
@{
    ViewData["BookInfoSizeClass"] = "book-info-lg";
}

<h1 class="fw-bold mb-5 text-[2rem] text-center"> Add Review</h1>

<form asp-action="Create" method="post" id="reviewForm">
    <input type="hidden" asp-for="Id" />

    @if (Model.Book is not null)
    {
        <input type="hidden" asp-for="BookId" />
        <div id="bookInfo" class="my-5">
            @await Html.PartialAsync("_BookInfoCard", Model.Book)
        </div>
    }
    else
    {
        <div class="form-group">
            <label asp-for="BookId"></label>
            <select asp-for="BookId" id="bookSelect" class="form-control">
                <option value="">-- Select a book --</option>
                @foreach (var b in Model.AvailableBooks)
                {
                    <option value="@b.Id">@b.Title (@b.PublicationYear)</option>
                }
            </select>
            <span asp-validation-for="BookId" class="text-danger"></span>
        </div>

        <div id="bookInfo">
            @foreach (var b in Model.AvailableBooks)
            {
                <div class="book-card-slot my-5" data-book-id="@b.Id" style="display:none;">
                    @await Html.PartialAsync("_BookInfoCard", b)
                </div>
            }
        </div>
    }

    <div class="form-group">
        <label asp-for="Score"></label>
        <input asp-for="Score" type="number" min="1" max="10" id="scoreInput" class="form-control" />
        <span asp-validation-for="Score" class="text-danger"></span>
    </div>

    <div id="scoreBarContainer">
        @await Html.PartialAsync("_ScoreBar", Model.Score)
    </div>

    <button type="submit" class="btn btn-primary">Submit Review</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function renderStars(score) {
            score = Math.max(0, Math.min(10, Number(score) || 0));
            let html = '<div class="score-bar" data-score="' + score + '"><div class="stars">';
            for (let i = 1; i <= 10; i++) {
                const hue = (i - 1) * 120 / 9;
                const style = i <= score ? `color: hsl(${hue}, 75%, 45%);` : 'color: #ddd;';
                html += `<span class="star" style="${style}">★</span>`;
            }
            html += '</div><span class="score-number">' + score + '/10</span></div>';
            return html;
        }

        document.getElementById('scoreInput').addEventListener('input', e => {
            document.getElementById('scoreBarContainer').innerHTML = renderStars(e.target.value);
        });

        const select = document.getElementById('bookSelect');
        if (select) {
            select.addEventListener('change', e => {
                document.querySelectorAll('.book-card-slot').forEach(el => el.style.display = 'none');
                const slot = document.querySelector(`.book-card-slot[data-book-id="${e.target.value}"]`);
                if (slot) slot.style.display = '';
            });
        }
    </script>
}