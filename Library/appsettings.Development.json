{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithEnvironmentUserName" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Level:u3}] [{SourceContext}] [{Timestamp:yyyy-MM-dd HH:mm:ss}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "outputTemplate": "[{Level:u3}] [{SourceContext}] [{Timestamp:yyyy-MM-dd HH:mm:ss}] {Message:lj}{NewLine}{Exception}",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      }
    ]
  },

  "ConnectionStrings": {
    "DBConnection": "SET_THIS_IN_ENV"
  },

  "Redis": {
    "Host": "SET_THIS_IN_ENV",
    "Port": "SET_THIS_IN_ENV",
    "Password": "SET_THIS_IN_ENV",
    "AbsoluteExpirationMinutes": 10
  }
}
